# Compiler files
cache/
out/

# Commonly ignored directories
.logs/
.ignore/

# Ignores development broadcast logs
!/broadcast
/broadcast/*/31337/
/broadcast/**/dry-run/

# Docs
docs/

# Dotenv file
.env
.env.*
!.env.example
node_modules/

# Timestamped copies of each broadcast; run-latest.json is the one worth keeping.
broadcast/*/*/run-[0-9]*.json
